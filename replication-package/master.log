. ***************************************
. * 2) Estimation
. *************************************** 
.         *IV and FAS
.         foreach v in any_vid_bwc any_tech_gun any_vid_fixed any_vid_mobile an
> y_vid_drone any_vid_car any_vid_weap {
  2.                 * OLS
.                 reg `v' $E  $X  ,cluster(ori9)
  3.                 replace ols_b =_b[$E] if outcome=="`v'" 
  4.                 replace ols_se=_se[$E] if outcome=="`v'" 
  5.                 replace ols_lb=_b[$E]-1.96*_se[$E] if outcome=="`v'"    
  6.                 replace ols_ub =_b[$E]+1.96*_se[$E] if outcome=="`v'"   
  7.                 
.                 * IV
.                 quietly : ivreg2 `v' ($E = $Zmain) $X  , first cluster(ori9)
  8.                 replace iv_b =_b[$E] if outcome=="`v'" 
  9.                 replace iv_se=_se[$E] if outcome=="`v'"                 
 10.                 replace iv_lb=_b[$E]-1.96*_se[$E] if outcome=="`v'"     
 11.                 replace iv_ub =_b[$E]+1.96*_se[$E] if outcome=="`v'"    
 12.                 
.                 * IV Lasso
.                 quietly : ivlasso `v' ($E = $Zmain) $X  , first cluster(ori9)
 13.                 replace ivlasso_b =_b[$E] if outcome=="`v'" 
 14.                 replace ivlasso_se=_se[$E] if outcome=="`v'" 
 15.                 replace ivlasso_lb=_b[$E]-1.96*_se[$E] if outcome=="`v'"  
>       
 16.                 replace ivlasso_ub =_b[$E]+1.96*_se[$E] if outcome=="`v'" 
>                       
 17.                 
.                 *FAS
.                 ivfas `v' ($E = $Zmain) $X  , first cluster(ori9)
 18.                 replace fas_lb=e(fas)[1, 1] if outcome=="`v'" 
 19.                 replace fas_ub=e(fas)[1, 2] if outcome=="`v'"           
 20.         }

