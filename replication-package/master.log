. 
. * all_placebos_compared.do issues `clear all`, which drops user programs.
. * Redefine run_rscript / run_do before the remaining R calls.
. capture program drop run_rscript

. program define run_rscript
  1.         args script
  2.         display as result "    [R] `script' — started `c(current_time)'"
  3.         shell Rscript "`script'"; echo $? > _r_exitcode.tmp
  4.         tempname fh
  5.         file open `fh' using "_r_exitcode.tmp", read text
  6.         file read `fh' line
  7.         file close `fh'
  8.         erase "_r_exitcode.tmp"
  9.         if "`line'" != "0" {
 10.                 display as error "    [R] `script' — FAILED (exit code `li
> ne')"
 11.                 exit 1
 12.         }
 13.         display as result "    [R] `script' — done `c(current_time)'"
 14. end

. 
. capture program drop run_do

. program define run_do
  1.         args script
  2.         display as result "    [do] `script' — started `c(current_time)'"
  3.         do "`script'"
  4.         display as result "    [do] `script' — done `c(current_time)'"
  5. end

