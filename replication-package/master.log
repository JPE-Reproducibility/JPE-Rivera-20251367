. do "scripts/config.do"

. *****************************************************************************
> ***
. * Master config for Stata scripts
. * All paths relative to replication/ root (run scripts from there)
. * Requires packages from scripts/00_setup.do — run that once before anything 
> else.
. *****************************************************************************
> ***
. 
. * Raw data
. global path_raw_wrds       "raw_data/wrds"

. global path_raw_rosters    "raw_data/rosters"

. global path_raw_edgar      "raw_data/edgar"

. global path_raw_fred       "raw_data/fred"

. global path_raw_bloomberg  "raw_data/bloomberg"

. global path_raw_survey     "raw_data/categorization"

. global path_raw_ibes       "raw_data/ibes"

. global path_raw_ps         "raw_data/private_security"

. global path_raw_exploration "raw_data/protests"

. 
. * Cleaned / intermediate data (read-write)
. global path_cleaned        "cleaned_data"

. 
. * SDID estimation outputs (intermediate R→Stata handoff, NOT draft-cited)
. global path_sdid           "cleaned_data/SDID"

. 
. * Final draft outputs (results/ layout mirrors draft/resultsV2/)
. global path_figures        "results/figures"

. global path_tables         "results/tables"

. global path_exploration_results "results/exploration"

. 
end of do-file

. 
. 
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. *Construct Portofolio
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. *****************************************************************************
> ***
. *1) Import Data to be merged later
. *****************************************************************************
> ***
. *a) Get the roster from the daily data
. use "$path_cleaned/returns_moredays.dta",clear

. 
.         keep gvkey permno group PD cusip tic cik conm sic group

.         duplicates drop

Duplicates in terms of all variables

(296,081 observations deleted)

. 
.         *temporary data
.         sort permno

.         tempfile gvkey_permno

. save `gvkey_permno'
file /var/folders/xc/7f33fnw51yx96ck5yq45k88m0000gr/T//St43685.000002 saved
    as .dta format

. 
. 
. ***************************
. *A) Factors - Monthly Freq
. ***************************
. gzimport delimited using "$path_raw_wrds/Factors - Monthly Frequency.csv.gz",
> clear
Importing gzipped data in raw_data/wrds/Factors - Monthly Frequency.csv.gz
(6 vars, 267 obs)

.         *Formatting/Cleaning
.          numdate daily mdy= dateff, pattern(YMD)
note: dateff is numeric; converting contents to string

.          gen year=year(mdy)

.          gen fyear=year

.          gen mofd=mofd(mdy)

.          format mofd %tm

.         *keep relevant
.          keep mofd mktrf smb hml rf umd

.         *temporary data
.         sort mofd

.         tempfile FF_factors

. save `FF_factors'
file /var/folders/xc/7f33fnw51yx96ck5yq45k88m0000gr/T//St43685.000003 saved
    as .dta format

. 
. 
. *****************************************************************************
> ****
. *2) Donor Pool for strongly connected firms (median number in portofolio=18)
. *****************************************************************************
> ****
. use  "$path_cleaned/final_monthly_RAW.dta",clear

.         *A) Prepare data for strong placebos
.         *Merge gvkey
.         sort permno

.         joinby permno using `gvkey_permno'

. 
.         *keep only sic with strongly connected firms
.         gen strong=group==3

.         bys sic: egen anystrong=max(strong)

.         keep if anystrong==1
(100,333 observations deleted)

. 
.         *keep only the placebos
.         keep if group==1
(8,245 observations deleted)

. 
.         *B) Create portofolios
.         foreach v of numlist 4/104{
  2.         preserve
  3.                 di "portofolio: " `v'
  4.                 set seed `v'
  5.                 sample 18, by(mofd) count
  6.                 gen rec=1
  7.                 *Weghted returns by mkt value
.                 bys mofd: egen totmkt=sum(lagmktvalue)
  8.                 gen wgt=(lagmktvalue)/totmkt
  9.                 *verify sum weights equal 1
.                 bys mofd: egen sumwgt=sum(wgt)
 10.                 gen wgtret=wgt*ret
 11. 
.                 *Collapse
.                 collapse (mean) ret (sum)nfirm_type3=rec wgtret (last)year,by
> (mofd)
 12.                         gen portofolio=`v'
 13.                         gen group=1
 14. 
.                         **********************************
.                         *Compute AR
.                         **********************************
.                         *Merge FF
.                         sort mofd
 15.                         merge m:1 mofd using `FF_factors'
 16.                         keep if _merge==3
 17.                         drop _merge
 18. 
.                         *Calculate exret with rolling window
.                         gen exret=.
 19.                         gen wexret=.
 20.                         gen netret=ret-rf
 21.                         gen wnetret=wgtret-rf
 22.                         gen n=_n-120 if year>=2010
 23.                         foreach l of numlist 1/143{
 24.                                 sum mofd if n==`l'
 25.                                 gen x=mofd-`r(mean)'
 26.                                 *Exreturn
.                                 quietly reg netret mktrf smb hml umd if x>=-6
> 0 & x<=-30
 27.                                 replace exret=ret-_b[_cons]-_b[mktrf]*mktr
> f-_b[smb]*smb-_b[hml]*hml-_b[umd]*umd if n==`l'
 28.                                 *Weighted Exreturn
.                                 quietly reg wnetret mktrf smb hml umd if x>=-
> 60 & x<=-30
 29.                                 replace wexret=ret-_b[_cons]-_b[mktrf]*mkt
> rf-_b[smb]*smb-_b[hml]*hml-_b[umd]*umd if n==`l'
 30.                                 drop x
 31.                         }
 32.                         keep if year>=2010
 33. 
.                 *temporary data
.                 sort portofolio mofd
 34.                 tempfile dt_donor_`v'
 35.                 save `dt_donor_`v''
 36.           restore
 37.         }
