. do "scripts/config.do"

. *****************************************************************************
> ***
. * Master config for Stata scripts
. * All paths relative to replication/ root (run scripts from there)
. * Requires packages from scripts/00_setup.do — run that once before anything 
> else.
. *****************************************************************************
> ***
. 
. * Raw data
. global path_raw_wrds       "raw_data/wrds"

. global path_raw_rosters    "raw_data/rosters"

. global path_raw_edgar      "raw_data/edgar"

. global path_raw_fred       "raw_data/fred"

. global path_raw_bloomberg  "raw_data/bloomberg"

. global path_raw_survey     "raw_data/categorization"

. global path_raw_ibes       "raw_data/ibes"

. global path_raw_ps         "raw_data/private_security"

. global path_raw_exploration "raw_data/protests"

. 
. * Cleaned / intermediate data (read-write)
. global path_cleaned        "cleaned_data"

. 
. * SDID estimation outputs (intermediate R→Stata handoff, NOT draft-cited)
. global path_sdid           "cleaned_data/SDID"

. 
. * Final draft outputs (results/ layout mirrors draft/resultsV2/)
. global path_figures        "results/figures"

. global path_tables         "results/tables"

. global path_exploration_results "results/exploration"

. 
end of do-file

. 
. *Labels/Subtitles
. global N0 "Death of Trayvon Martin"

. global N1 "Acquittal of George Zimmerman"

. global N2 "Mistrial in the Jordan Davis Shooting"       

. global N3 "Death of Michael Brown"

. global N4 "Death of Tamir Rice"

. global N5 "Death of Alton Sterling"     

. global N6 "Death of George Floyd"

. global N7 "A. Pooled Effects"

. 
. 
.         
. *****************************************************************************
> ***
. * Append R-results for CAR
. *****************************************************************************
> ***
. use "$path_sdid/SDID_privatesecurity_panel_0.dta",clear

. gen df=0

. foreach v in 1 2 3 4 5 6 {
  2.         append using "$path_sdid/SDID_privatesecurity_panel_`v'.dta"
  3.         replace df=`v' if df==.
  4. }
(168 real changes made)
(168 real changes made)
(168 real changes made)
(168 real changes made)
(168 real changes made)
(168 real changes made)

. 
. *Add pooled results
. append using "$path_sdid/SDID_privatesecurity_panel_-1.dta"

. replace df=7 if df==.
(168 real changes made)

. 
. 
. *****************************************************************************
> ***
. * 1c) Plot-CAR results for SDID
. *****************************************************************************
> ***
. foreach v in 0 1 2 3 4 5 6 7 {
  2.                 *Collect mean 
.                 su Y_sdid if type_sdid=="treated" & x_sdid==-21 & df==`v'
  3.                 global mdv =trim("`: display %10.3f `r(mean)''")
  4.                 
.                 *Collect the effect
.                 su b_sdid   if df==`v'
  5.                 global bSDIDstrong =trim("`: display %10.3f `r(mean)''")  
>       
  6.                 su se_sdid  if  df==`v'
  7.                 global seSDIDstrong =trim("`: display %10.3f `r(mean)''") 
>               
  8. 
. 
.                 *Plot
.                 twoway (connected Y_sdid x_sdid if x_sdid>-22 & df==`v' & typ
> e_sdid=="treated"           ,lco(blue%70)  mco(blue%70) lwidth(med)  lpa(soli
