. *****************************************************************************
> ***
. * Append R-results for CAR
. *****************************************************************************
> ***
. use "$path_sdid/SDID_privatesecurity_refined_isc_panel_0.dta",clear

. gen df=0

. foreach v in  1 2 3 4 5 6 {
  2.         append using "$path_sdid/SDID_privatesecurity_refined_isc_panel_`v
> '.dta"
  3.         replace df=`v' if df==.
  4. }
