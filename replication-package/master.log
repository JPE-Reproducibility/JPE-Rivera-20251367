> ) lab(2 "Synthetic")  order(1 2))  ///
>                            title({bf:${N`v'}},color(black) pos(1) size(med)) 
> ///
>                                 subtitle("sdid{sub:private-security} = $bSDID
> strong (s.e.=$seSDIDstrong)" , ///
>                            size(med) position(11) ring(0) color(gs6%90)) 
  9. 
.                            graph export "$path_figures/private_security/SDID_
> private_security_isc_`v'.pdf",replace
