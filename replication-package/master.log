. *****************************************************************************
> ***
. * 1c) Plot-CAR results for SDID
. *****************************************************************************
> ***
. foreach v in 0 1 2 3 4 5 6 7 {
  2.                 *Collect mean 
.                 su Y_sdid if type_sdid=="treated" & x_sdid==-21 & df==`v'
  3.                 global mdv =trim("`: display %10.3f `r(mean)''")
  4.                 
.                 *Collect the effect
.                 su b_sdid   if df==`v'
  5.                 global bSDIDstrong =trim("`: display %10.3f `r(mean)''")  
>       
  6.                 su se_sdid  if  df==`v'
  7.                 global seSDIDstrong =trim("`: display %10.3f `r(mean)''") 
>               
  8. 
. 
.                 *Plot
.                 twoway (connected Y_sdid x_sdid if x_sdid>-22 & df==`v' & typ
> e_sdid=="treated"           ,lco(blue%70)  mco(blue%70) lwidth(med)  lpa(soli
> d) msymbol(O) msize(small)) || ///
>                            (line      Y_sdid x_sdid if x_sdid>-22 & df==`v' &
>  type_sdid=="synthetic control" ,lco(blue%70)  lwidth(med) lpa(-)) || , ///
