.                 * IV
.                 eststo clear

.                 foreach v in fixed mobile drone car weap  {
  2.                         eststo: ivreg2 any_vid_`v' ($E=$Z0) $X            
> ,cluster(ori9) first
  3.                         global ovid1 ="`: display %10.2f `e(jp)''"
  4.                         global fstage="`: display %10.2f `e(widstat)''"   
>               
  5.                         estimates store C_`v'   
  6.                         sum any_vid_`v'  
  7.                         quietly estadd local ymean   "`: display %10.2f `r
> (mean)''"     , replace       
  8.                 quietly estadd local fstage "$fstage", replace          
  9.                 *quietly estadd local overid "$ovid1", replace            
>       
.                         quietly estadd local control "Yes", replace     
 10.                         quietly estadd local spec    "2SLS", replace      
>                                                       
 11.                 }               

