. 
. * C) Append Data
. use `dt_donor_4',clear

. foreach v of numlist 5/104{
  2.         append using `dt_donor_`v''
  3. }

. 
.         *Events, Need to be careful with weekends and holidays
.         *Death of Trayvon Martinm(2/26/2012)---SUNDAY
.         gen event0=mofd(mdy(2,26,2012)+1)

.         * Acquittal of George Zimmerman (7/13/2013)---SATURDAY
.         gen event1=mofd(mdy(7,13,2013)+2)

. 
.         *Time until event
.         foreach v in 0 {
  2.                 su mofd if mofd==event`v'
  3.                 gen t`v'=mofd-r(mean)
  4.         }

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
        mofd |        101         625           0        625        625

.         sort portofolio mofd t0

.     by portofolio: gen sumR=sum(ret)    if t0>=-25

.     by portofolio: gen sumAR=sum(exret) if t0>=-25

.     by portofolio: gen sumwAR=sum(wexret) if t0>=-25

.         drop if sumR==.
(0 observations deleted)

.         drop if sumAR==.
(0 observations deleted)

.         gen Et=t0

. 
.         *Treat
.         gen PDstocks=group==2 | group==3

.         gen Treat=PDstocks==1 & Et>=0

. 
.         *Group of estimation
.         gen estimation=3

. 
. *Save data
. sort portofolio mofd

. save "$path_cleaned/placebos_strong_portfolio.dta",replace
(file cleaned_data/placebos_strong_portfolio.dta not found)
file cleaned_data/placebos_strong_portfolio.dta saved

. 
. 
. *****************************************************************************
> ****
. *3) Donor Pool for weakly connected firms (median number in portofolio=58)
. *****************************************************************************
> ****
. use  "$path_cleaned/final_monthly_RAW.dta",clear

.         *A) Prepare data for weak placebos
.         *Merge gvkey
.         sort permno

.         joinby permno using `gvkey_permno'

. 
.         *keep only sic with weakly connected firms
.         gen weak=group==2

.         bys sic: egen anyweak=max(weak)

.         keep if anyweak==1
(5,749 observations deleted)

. 
.         *keep only the placebos
.         keep if group==1
(17,080 observations deleted)

. 
.         *B) Create portofolios
.         foreach v of numlist 4/104{
  2.         preserve
  3.                 di "portofolio: " `v'
  4.                 set seed `v'
  5.                 sample 58, by(mofd) count
  6.                 gen rec=1
  7.                 *Weghted returns by mkt value
.                 bys mofd: egen totmkt=sum(lagmktvalue)
  8.                 gen wgt=(lagmktvalue)/totmkt
  9.                 *verify sum weights equal 1
.                 bys mofd: egen sumwgt=sum(wgt)
 10.                 gen wgtret=wgt*ret
 11. 
.                 *Collapse
.                 collapse (mean) ret (sum)nfirm_type2=rec wgtret (last)year,by
> (mofd)
 12.                         gen portofolio=`v'
 13.                         gen group=1
 14. 
.                         **********************************
.                         *Compute AR
.                         **********************************
.                         *Merge FF
.                         sort mofd
 15.                         merge m:1 mofd using `FF_factors'
 16.                         keep if _merge==3
 17.                         drop _merge
 18. 
.                         *Calculate exret with rolling window
.                         gen exret=.
 19.                         gen wexret=.
 20.                         gen netret=ret-rf
 21.                         gen wnetret=wgtret-rf
 22.                         gen n=_n-120 if year>=2010
 23.                         foreach l of numlist 1/143{
 24.                                 sum mofd if n==`l'
 25.                                 gen x=mofd-`r(mean)'
 26.                                 *Exreturn
.                                 quietly reg netret mktrf smb hml umd if x>=-6
> 0 & x<=-30
 27.                                 replace exret=ret-_b[_cons]-_b[mktrf]*mktr
> f-_b[smb]*smb-_b[hml]*hml-_b[umd]*umd if n==`l'
 28.                                 *Weighted Exreturn
.                                 quietly reg wnetret mktrf smb hml umd if x>=-
> 60 & x<=-30
 29.                                 replace wexret=ret-_b[_cons]-_b[mktrf]*mkt
> rf-_b[smb]*smb-_b[hml]*hml-_b[umd]*umd if n==`l'
 30.                                 drop x
 31.                         }
 32.                         keep if year>=2010
 33. 
.                 *temporary data
.                 sort portofolio mofd
 34.                 tempfile dt_donor_`v'
 35.                 save `dt_donor_`v''
 36.           restore
 37.         }
