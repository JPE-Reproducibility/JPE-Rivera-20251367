.         keep if year>=2010
(120 observations deleted)

. 
.         *Events, Need to be careful with weekends and holidays
.         *Death of Trayvon Martinm(2/26/2012)---SUNDAY
.         gen event0=mofd(mdy(2,26,2012)+1)

.         * Acquittal of George Zimmerman (7/13/2013)---SATURDAY
.         gen event1=mofd(mdy(7,13,2013)+2)

. 
.         *Time until event
.         foreach v in 0 {
  2.                 su mofd if mofd==event`v'
  3.                 gen t`v'=mofd-r(mean)
  4.         }

    Variable |        Obs        Mean    Std. dev.       Min        Max
-------------+---------------------------------------------------------
        mofd |          1         625           .        625        625

.         sort portofolio mofd t0

.     by portofolio: gen sumR=sum(ret)    if t0>=-25

.     by portofolio: gen sumAR=sum(exret) if t0>=-25

.     by portofolio: gen sumwAR=sum(wexret) if t0>=-25

.         drop if sumR==.
(0 observations deleted)

.         drop if sumAR==.
(0 observations deleted)

.         gen Et=t0

. 
.         *Treat
.         gen PDstocks=group==2 | group==3

.         gen Treat=PDstocks==1 & Et>=0

. 
.         *Group of estimation
.         gen estimation=3

. 
. *Save data
. sort portofolio mofd

. save "$path_cleaned/strong_portfolio.dta",replace
(file cleaned_data/strong_portfolio.dta not found)
file cleaned_data/strong_portfolio.dta saved

. 
. ***************************
. *C) Weakly Connected
. ***************************
. use  "$path_cleaned/final_monthly_RAW.dta",clear

.         *Merge gvkey
.         sort permno

.         joinby permno using `gvkey_permno'

.         *Keep weakly connected firms
.         keep if group==2
(120,888 observations deleted)

.         gen rec=1

.         *Weighted returns by mkt value
.         bys mofd: egen totmkt=sum(lagmktvalue)

.         gen wgt=(lagmktvalue)/totmkt
(97 missing values generated)

.                 *verify sum weights equal 1
.                 bys mofd: egen sumwgt=sum(wgt)

.         gen wgtret=wgt*ret
(110 missing values generated)

. 
.         *Collapse
.         collapse (mean) ret (sum)nfirm_type2=rec wgtret (last)year,by(mofd)

.     gen portofolio=2

.         gen group=2

.         su nfirm_type2,detail

                          (sum) rec
-------------------------------------------------------------
      Percentiles      Smallest
 1%           46             46
 5%           46             46
10%           47             46       Obs                 267
25%           49             46       Sum of wgt.         267

50%           56                      Mean           54.20225
                        Largest       Std. dev.      4.817371
75%           58             60
90%           59             60       Variance       23.20706
95%           60             60       Skewness      -.4723248
99%           60             61       Kurtosis       1.651417

. 
.         **********************************
.         *Compute AR
.         **********************************
.         *Merge FF
.         sort mofd

.         merge m:1 mofd using `FF_factors'

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                               267  (_merge==3)
    -----------------------------------------

.         keep if _merge==3
(0 observations deleted)

.         drop _merge

. 
.         *Calculate exret with rolling window
.         gen exret=.
(267 missing values generated)

.         gen wexret=.
(267 missing values generated)

.         gen netret=ret-rf

.         gen wnetret=wgtret-rf

.         gen n=_n-120 if year>=2010
(120 missing values generated)

.         foreach l of numlist 1/143{
  2.                 sum mofd if n==`l'
  3.                 gen x=mofd-`r(mean)'
  4.                 *Exreturn
.                 quietly reg netret mktrf smb hml umd if x>=-60 & x<=-30
  5.                 replace exret=ret-_b[_cons]-_b[mktrf]*mktrf-_b[smb]*smb-_b
> [hml]*hml-_b[umd]*umd if n==`l'
  6.                 *Weighted Exreturn
.                 quietly reg wnetret mktrf smb hml umd if x>=-60 & x<=-30
  7.                 replace wexret=ret-_b[_cons]-_b[mktrf]*mktrf-_b[smb]*smb-_
> b[hml]*hml-_b[umd]*umd if n==`l'
  8.                 drop x
  9.         }

