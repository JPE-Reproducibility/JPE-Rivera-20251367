>                            xlabel(-21(3)21,labsize(small)) ///
>                            ytitle("Cumulative Abnormal Return",size(med) col(
> gs3)) xtitle("Trading Day",size(med) col(gs3)) ///
>                            graphregion(color(white)) bgcolor(white) ///
>                            xline(0,lpattern(dash)  lcolor(gs13) lwidth(med) l
> style(foreground)) ///
