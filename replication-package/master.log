. *****************************************************************************
> ***
. * B) Regression on BWC + Gunshot Technology Adoption
. *****************************************************************************
> ***
. eststo clear

. foreach v in any_vid_bwc any_tech_gun {
  2.         * OLS
.         eststo: reg `v'  $E  $X               ,cluster(ori9) 
  3.         sum `v'  
  4.         quietly estadd local ymean   "`: display %10.2f `r(mean)''"     , 
> replace       
  5.         quietly estadd local control "Yes", replace             
  6.         quietly estadd local fstage "---", replace
  7.         quietly estadd local overid "---", replace      
  8.         quietly estadd local spec    "OLS", replace             
  9.         
.         * IV Lasso              
.         eststo: ivlasso   `v' ($E=$Z0)  $X  ,cluster(ori9)
 10.         sum `v'   
 11.         quietly estadd local ymean   "`: display %10.2f `r(mean)''"     , 
> replace               
 12.         quietly estadd local fstage "---", replace
 13.         quietly estadd local overid "---", replace              
 14.         quietly estadd local control "Yes", replace     
 15.         quietly estadd local spec    "IV-Lasso", replace                
 16.                 
.         * IV                    
.         eststo: ivreg2 `v' ($E=$Z0)   $X         ,cluster(ori9) first
 17.         global ovid1 ="`: display %10.2f `e(jp)''"
 18.         global fstage="`: display %10.2f `e(widstat)''"
 19.         sum `v' 
 20.         quietly estadd local ymean   "`: display %10.2f `r(mean)''"     , 
> replace       
 21.         quietly estadd local fstage "$fstage", replace  
 22.         *quietly estadd local overid "$ovid1", replace  
.         quietly estadd local control "Yes", replace     
 23.         quietly estadd local spec    "2SLS", replace            
 24. }

